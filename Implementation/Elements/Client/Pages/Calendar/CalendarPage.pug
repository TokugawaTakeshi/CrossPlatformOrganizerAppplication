extends ../../Layouts/Main/MainLayout.pug


block Data

  -
    
    const tabsData = {
      
      monthOverview: {
        tabHTML_ID: "MONTH_OVERVIEW--TAB",
        panelHTML_ID: "MONTH_OVERVIEW--TAB_PANEL",
        isInitiallySelected: false,
        label: "Month"
      },

      dayOverview: {
        tabHTML_ID: "DAY_OVERVIEW--TAB",
        panelHTML_ID: "DAY_OVERVIEW--TAB_PANEL",
        isInitiallySelected: true,
        label: "Day"
      }
      
    };

  
block append Requirements

  include ../../StaticPreview/_Requirements.pug
    

block append Metadata

  -

    RegularWebPageTemplate__YDF.configure({
      metadata: {
        title: "Tasks management — Experimental CSharp Application",
        locale: $$HTML_TAG_LANG_ATTRIBUTE_VALUE
      },
      stylesSheetsURIs: [ "@Shared/Primer", "@ExternalSharedGUI_Components", "@Shared/Internals" ]
    });

    YDF.RoutingEmulator.setCurrentRoute("calendar");


block append SpecificContent

  .CalendarPage-SpecificContent.MainLayout-VerticallyFillingSpecificContentDescendant
    
    +TabsList--YDF({ accessibilityGuidance: "Select View" }).CalendarPage-TabsList
      +Tab--YDF(tabsData.monthOverview)
      +Tab--YDF(tabsData.dayOverview)
      
    +TabPanel--YDF(tabsData.monthOverview).CalendarPage-TabPanel

      +MonthViewer.CalendarPage-MonthViewer
      
    +TabPanel--YDF(tabsData.dayOverview).CalendarPage-TabPanel

      +DayViewer()
