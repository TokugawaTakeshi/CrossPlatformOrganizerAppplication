@using YamatoDaiwa.CSharpExtensions
@using YamatoDaiwa.Frontend.Helpers

@implements YamatoDaiwa.Frontend.GUI_Components.Abstractions.IHTML_AttributesFallthrough


<div
  class=@CSS_Class.AppendOneFromHTML_AttributesIfExists("PersonCard PersonCard__LoadingPlaceholder", rootElementHTML_Attributes)
  @attributes=@rootElementHTML_Attributes?.DeleteOnePairFromSwallowCopy("class").UpdatedDictionary 
>

  <div class="PersonCard-Avatar PersonCard-Avatar__LoadingPlaceholder"></div>
  
  <div class="PersonCard-Metadata">
    
    <div class="PersonCard-Metadata-Value--LoadingPlaceholder-OfficialName"></div>
    
    <div class="PersonCard-Metadata-Value--LoadingPlaceholder-OfficialNameSpell"></div>
    
    <div class="PersonCard-Metadata-Key--LoadingPlaceholder PersonCard-Metadata-Key--LoadingPlaceholder__Email"></div>
    <div class="PersonCard-Metadata-Value--LoadingPlaceholder-Email"></div>
    
    <div class="PersonCard-Metadata-Key--LoadingPlaceholder PersonCard-Metadata-Key--LoadingPlaceholder__Phone"></div>
    <div class="PersonCard-Metadata-Value--LoadingPlaceholder-Phone"></div>
    
  </div>
  
</div>


@code {

  [Microsoft.AspNetCore.Components.Parameter(CaptureUnmatchedValues = true)]
  public Dictionary<string, object>? rootElementHTML_Attributes { get; set; }

}
