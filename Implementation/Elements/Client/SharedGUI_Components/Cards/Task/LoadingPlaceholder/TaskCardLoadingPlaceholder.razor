@using YamatoDaiwa.CSharpExtensions
@using YamatoDaiwa.Frontend.Helpers

@using YamatoDaiwa.Frontend.GUI_Components.Badge.LoadingPlaceholder

@implements YamatoDaiwa.Frontend.GUI_Components.Abstractions.IHTML_AttributesFallthrough


<div 
  class=@CSS_Class.AppendOneFromHTML_AttributesIfExists("TaskCard TaskCard__LoadingPlaceholder", rootElementHTML_Attributes)
  @attributes=@rootElementHTML_Attributes?.DeleteOnePairFromSwallowCopy("class").UpdatedDictionary
>
  
  <div class="TaskCard-Checkbox TaskCard-Checkbox__LoadingPlaceholder"></div>
  <div class="TaskCard-Title TaskCard-Title__LoadingPlaceholder"></div>
  
  <div class="TaskCard-BadgesFlow">
    @foreach (uint _ in new uint[2])
    {
      <BadgeLoadingPlaceholder/>
    }
  </div>
  
  <div class="TaskCard-Description TaskCard-Description__LoadingPlaceholder"></div>
  
</div>


@code {

  [Microsoft.AspNetCore.Components.Parameter(CaptureUnmatchedValues = true)]
  public Dictionary<string, object>? rootElementHTML_Attributes { get; set; }

}
