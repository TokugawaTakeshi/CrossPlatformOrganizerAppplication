mixin PeopleViewer(statesSimulations)

  - 

    /**
     * @type {
     *   Readonly<{
     *     loading?: boolean;
     *     error?: boolean;
     *     noItems?: boolean;
     *     noSearchResults?: boolean;
     *   }>
     * }
     */
    statesSimulations = statesSimulations ?? {};
    
    /**
     * @typedef PeopleViewerLocalization
     * @property { string } searchBox.placeholder
     * @property { string } searchBox.accessibilityGuidance
     * @property { string } buttons.personAdding.label
     * @property { string } buttons.retryingOfDataRetrieving.label
     * @property { string } buttons.immediateAddingOfFirstPerson.label
     * @property { string } buttons.resettingOfFiltering.label
     * @property { string } buttons.peopleFiltering.label
     * @property { string } errors.peopleRetrieving.title
     * @property { string } errors.peopleRetrieving.description
     * @property { string } guidances.noItemsAvailable
     * @property { string } guidances.noItemsFound
     * @property { string } accessibilityGuidances.dataRetrievingInProgress
     */
    
    /** @type { PeopleViewerLocalization } */
    const $$componentLocalizedStringResources = $$localizedStringResources.components.viewers.people;
        

  .PeopleViewer&attributes(attributes)

    .PeopleViewer-TopActionBar

      +SearchBox--YDF({
        placeholder: $$componentLocalizedStringResources.searchBox.placeholder,
        accessibilityGuidance: $$componentLocalizedStringResources.searchBox.accessibilityGuidance
      }).PeopleViewer-TopActionBar-SearchBox
      
      +Button--YDF.PeopleViewer-TopActionBar-ButtonForWideContainers
        +Person__Plus--YDF_Icon.Button--YDF-SVG_Icon
        span.Button--YDF-Label= $$componentLocalizedStringResources.buttons.personAdding.label
    
    if statesSimulations.loading

      .PeopleViewer-CardsFlow

        .PeopleViewer-VisuallyHiddenAccessibilityGuidance(
          role="alert"
        )= $$componentLocalizedStringResources.accessibilityGuidances.dataRetrievingInProgress

        each cardNumber in Array.from(new Array(12).keys())

          +PersonCardLoadingPlaceholder
        
    else if statesSimulations.error

      +AdmonitionBlock--YDF({
        title: $$componentLocalizedStringResources.errors.peopleRetrieving.title,
        decorativeVariation: AdmonitionBlock__YDF.DecorativeVariations.error,
        SVG_Icon: true
      }).PeopleViewer-AdmonitionBlock

        p= $$componentLocalizedStringResources.errors.peopleRetrieving.description

        +Button--YDF({
          label: $$componentLocalizedStringResources.buttons.retryingOfDataRetrieving.label
        }).AdmonitionBlock--YDF-CenteredButton
        
    else if statesSimulations.noItems

      +AdmonitionBlock--YDF({
        decorativeVariation: AdmonitionBlock__YDF.DecorativeVariations.guidance,
        SVG_Icon: true
      }).PeopleViewer-AdmonitionBlock

        p= $$componentLocalizedStringResources.guidances.noItemsAvailable

        +Button--YDF({
          label: $$componentLocalizedStringResources.buttons.immediateAddingOfFirstPerson.label
        }).AdmonitionBlock--YDF-CenteredButton
        
    else if statesSimulations.noSearchResults

      +AdmonitionBlock--YDF({
        decorativeVariation: AdmonitionBlock__YDF.DecorativeVariations.guidance,
        SVG_Icon: true
      }).PeopleViewer-AdmonitionBlock

        p= $$componentLocalizedStringResources.guidances.noItemsFound

        +Button--YDF({
          HTML_Type: Button__YDF.HTML_Types.regular,
          label: $$componentLocalizedStringResources.buttons.resettingOfFiltering.label
        }).AdmonitionBlock--YDF-CenteredButton

    else

      ul.PeopleViewer-CardsFlow

        each person in $mockData.people

          +PersonCard({
            person,
            rootElementTag: "li"
          })

          
    .PeopleViewer-BottomActionBarForNarrowContainers

      +Button--YDF
        +Person__Plus--YDF_Icon.Button--YDF-SVG_Icon
        span.Button--YDF-Label= $$componentLocalizedStringResources.buttons.personAdding.label
