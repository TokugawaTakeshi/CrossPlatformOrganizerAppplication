.TasksFoldersList-Item

  COLLAPSING_TOGGLE_EQUAL_WIDTH_AND_HEIGHT = 20px
  

  &:has(.TasksFoldersList-Item-ContextMenu)

    display grid

    grid-template-areas\
        "COLLAPSING_TOGGLE INTERACTIVE_LABEL CONTEXT_MENU"\
        "CHILD_LIST        CHILD_LIST        CHILD_LIST"

    grid-template-columns auto minmax(0, 1fr) auto
    align-items center
  

  &-CollapsingToggle

    ButtonLikeElementsPrimer--YDF()

    display inline-flex
    border-radius: buildCalcExpression--YDF(\
      "${ EQUAL_WIDTH_AND_HEIGHT }/2", 
      { EQUAL_WIDTH_AND_HEIGHT: COLLAPSING_TOGGLE_EQUAL_WIDTH_AND_HEIGHT }
    )

    cursor pointer

    grid-area COLLAPSING_TOGGLE
    align-self center
    

    &:focus

      box-shadow: 0 0 4px 2px YDF_ColorPalette.skyBlue.bright


    &-Icon

      height COLLAPSING_TOGGLE_EQUAL_WIDTH_AND_HEIGHT

      fill: W3C_39_ShadesOfGray--YDF[24]


      ../:hover &

        fill: W3C_39_ShadesOfGray--YDF[12]


      ../:active &

        fill: W3C_39_ShadesOfGray--YDF[16]


  &-InteractiveLabel

    ButtonLikeElementsPrimer--YDF()

    display flex
    align-items center
    column-gap 6px

    width 100%
    border-width 2px
    border-radius 4px
    Paddings--YDF({ horizontalSymmetric: 4px, verticalSymmetric: 4px })

    border-style solid
    border-color transparent
    background-clip padding-box

    grid-area INTERACTIVE_LABEL
    
    
    /.TasksFoldersList-Item__Selected > &
    
      background-color: YDF_ColorPalette.deepSkyBlue.mediumDark
    
    
    ../ button.TasksFoldersList-Item-InteractiveLabel

      cursor pointer
      
  
      &:hover
  
        background-color: YDF_ColorPalette.skyBlue.pastelLight

  
      &:focus
  
        box-shadow: inset 0 0 0 2px YDF_ColorPalette.skyBlue.light
  
  
      &:active
  
        background-color: YDF_ColorPalette.skyBlue.pastelSlightlyLight
  
  
      &:disabled
  
        pointer-events none
    

    &-Icon
  
      EQUAL_WIDTH_AND_HEIGHT = 20px
  
      width EQUAL_WIDTH_AND_HEIGHT
      height EQUAL_WIDTH_AND_HEIGHT
  
      fill: W3C_39_ShadesOfGray--YDF[20]
  
      flex-shrink 0
  
  
      /.TasksFoldersList-Item__Selected > .TasksFoldersList-Item-InteractiveLabel:not(:hover):not(:focus-visible):not(:active) > &
      
        fill white
  
  
      /.TasksFilteringPanel-List-Item-Button:disabled &
  
        fill: W3C_39_ShadesOfGray--YDF[28]
    

    &-Text

      applyTextGeometryWithoutExtraSpaceCausedByLineHeight--YDF({
        fontSize: 14px,
        lineSpacing: 4px,
        mustAllowWordsBreakingAnywhere: true
      })

      text-align left

      color: W3C_39_ShadesOfGray--YDF[12]


      /.TasksFoldersList-Item__Selected > .TasksFoldersList-Item-InteractiveLabel:not(:hover):not(:focus-visible):not(:active) > &
      
        color white


      /.TasksFilteringPanel-List-Item-Button:disabled &

        color: W3C_39_ShadesOfGray--YDF[28]
        
        
      &__LoadingPlaceholder
      
        display block
      
        LoadingPlaceholder({
          width: 1000%,
          height: 1em,
          borderRadius: 4px
        })
    

    &-TextBox

      flex-grow 1


  &-ContextMenu

    grid-area CONTEXT_MENU


    &-Toggle

      ButtonLikeElementsPrimer--YDF()

      display inline-flex
      cursor pointer


      &-Icon

        height 20px

        fill: W3C_39_ShadesOfGray--YDF[24]


  >.TasksFoldersList

    VERTICAL_LINE_THICKNESS = 2px

    border-left-width 2px
    padding-left 8px
    
    border-left-style solid
    border-left-color W3C_39_ShadesOfGray--YDF[32]

    grid-area CHILD_LIST

    margin-left 0.5*COLLAPSING_TOGGLE_EQUAL_WIDTH_AND_HEIGHT - VERTICAL_LINE_THICKNESS
